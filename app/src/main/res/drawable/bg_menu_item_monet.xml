<?xml version="1.0" encoding="utf-8"?>
<!-- bg_menu_item_monet.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#19253C" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#263A58" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#111D2E" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#1A2C46" />
        </shape>
    </item>
</selector>
