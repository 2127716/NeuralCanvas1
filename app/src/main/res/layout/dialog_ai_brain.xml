<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_ai_brain.xml -->
<!-- AI 主脑弹窗 — 现代莫奈3深色风格 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_monet"
    android:padding="0dp">

    <!-- ── Header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="16dp"
        android:paddingTop="22dp"
        android:paddingBottom="14dp">

        <!-- Icon -->
        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="🧠"
            android:textSize="20sp"
            android:gravity="center"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI 主脑"
                android:textColor="#F0F4FF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="智能分析与自动推进"
                android:textColor="#6B7FA3"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── Divider ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E2A42"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

    <!-- ── Scrollable body ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="8dp">

            <!-- ── API 配置 section ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API 配置"
                android:textColor="#8FA3C8"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <!-- Enable AI toggle row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_section_monet"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="启用 AI API"
                    android:textColor="#C8D4EE"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchEnableApi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />

            </LinearLayout>

            <!-- Base URL -->
            <EditText
                android:id="@+id/etBaseUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_monet"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textColor="#EEF2FF"
                android:textColorHint="#3D5070"
                android:hint="Base URL"
                android:textSize="14sp"
                android:inputType="textUri"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp" />

            <!-- API Key -->
            <EditText
                android:id="@+id/etApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_monet"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textColor="#EEF2FF"
                android:textColorHint="#3D5070"
                android:hint="API Key"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:layout_marginBottom="8dp" />

            <!-- Model Name -->
            <EditText
                android:id="@+id/etModelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_monet"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textColor="#EEF2FF"
                android:textColorHint="#3D5070"
                android:hint="模型名"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <!-- ── 自动巡航 section ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自动巡航"
                android:textColor="#8FA3C8"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <!-- Toggle rows inside a card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_section_monet"
                android:layout_marginBottom="12dp">

                <!-- Enable autopilot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="启用 API 自动巡航"
                        android:textColor="#C8D4EE"
                        android:textSize="14sp" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAutopilot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#12203A" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                <!-- Auto execute low-risk -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="自动执行低风险改动"
                        android:textColor="#C8D4EE"
                        android:textSize="14sp" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAutoExecute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#12203A" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                <!-- Background remind -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="后台提醒"
                        android:textColor="#C8D4EE"
                        android:textSize="14sp" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchBgRemind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#12203A" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                <!-- Trigger on app open -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="打开 App 时触发巡航脉冲"
                        android:textColor="#C8D4EE"
                        android:textSize="14sp" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchTriggerOnOpen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

            </LinearLayout>

            <!-- Max nodes per patrol -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每次巡航最多处理节点数"
                android:textColor="#8FA3C8"
                android:textSize="12sp"
                android:letterSpacing="0.04"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etMaxNodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_monet"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textColor="#EEF2FF"
                android:text="8"
                android:textSize="14sp"
                android:inputType="number"
                android:layout_marginBottom="20dp" />

            <!-- ── 巡航范围 section ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="巡航范围"
                android:textColor="#8FA3C8"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <RadioGroup
                android:id="@+id/rgPatrolScope"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_section_monet"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginBottom="20dp">

                <RadioButton
                    android:id="@+id/rbSubgraph"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="相关子图"
                    android:textColor="#C8D4EE"
                    android:textSize="14sp"
                    android:checked="true"
                    android:buttonTint="#7C9EFF" />

                <RadioButton
                    android:id="@+id/rbFullGraph"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="整张图"
                    android:textColor="#C8D4EE"
                    android:textSize="14sp"
                    android:buttonTint="#7C9EFF" />

            </RadioGroup>

            <!-- ── System prompt ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="系统提示词"
                android:textColor="#8FA3C8"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etSystemPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_monet"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textColor="#EEF2FF"
                android:textColorHint="#3D5070"
                android:hint="请作为我的第二大脑，自动分析图谱…"
                android:textSize="14sp"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4"
                android:gravity="top|start"
                android:layout_marginBottom="8dp" />

        </LinearLayout>
    </ScrollView>

    <!-- ── Divider ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E2A42"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="4dp" />

    <!-- ── Action bar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnSaveConfig"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="保存配置"
            android:textColor="#7C9EFF"
            android:textSize="14sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <Button
            android:id="@+id/btnClose"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="关闭"
            android:textColor="#8FA3C8"
            android:textSize="14sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <Button
            android:id="@+id/btnSend"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="发送"
            android:textColor="#7C9EFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

    </LinearLayout>

</LinearLayout>
