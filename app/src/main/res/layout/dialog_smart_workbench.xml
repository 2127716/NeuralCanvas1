<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_smart_workbench.xml -->
<!-- 智能工作台弹窗 — 莫奈3深色风格 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_monet"
    android:padding="0dp">

    <!-- ── Header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="22dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="智能工作台"
            android:textColor="#F0F4FF"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="减少按钮，把分析、修复、引导合成一条自动链"
            android:textColor="#5A7299"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- ── Divider ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E2A42"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

    <!-- ── Suggestion card ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_section_monet"
        android:layout_margin="16dp"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvSuggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="系统建议你先处理：新节点\n• 有学习节点没有进入记忆闭环\n\n最优先：新节点 —— 学习节点没有复习安排或迁移验证"
            android:textColor="#C8D4EE"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.4" />

    </LinearLayout>

    <!-- ── Quick action buttons ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnAutopilot"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="自动巡航"
            android:textColor="#8FA3C8"
            android:textSize="13sp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@android:color/transparent"
            android:strokeColor="#2A3F5C" />

        <Button
            android:id="@+id/btnPatrol"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="项目巡检"
            android:textColor="#8FA3C8"
            android:textSize="13sp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@android:color/transparent"
            android:strokeColor="#2A3F5C" />

        <Button
            android:id="@+id/btnAiAssist"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="AI 助手"
            android:textColor="#8FA3C8"
            android:textSize="13sp"
            android:backgroundTint="@android:color/transparent"
            android:strokeColor="#2A3F5C" />

    </LinearLayout>

    <!-- ── Section: 最值得先处理 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最值得先处理"
            android:textColor="#E8EEFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvTopPriority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前没有内容"
            android:textColor="#3D5270"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ── Section: 待复盘 / 待复习 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="待复盘 / 待复习"
            android:textColor="#E8EEFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvReview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前没有内容"
            android:textColor="#3D5270"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ── Section: 高风险 / 受阻 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="高风险 / 受阻"
            android:textColor="#E8EEFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvBlocked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前没有内容"
            android:textColor="#3D5270"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ── Divider ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E2A42"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

    <!-- ── Footer ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnCloseWorkbench"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="关闭"
            android:textColor="#7C9EFF"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
