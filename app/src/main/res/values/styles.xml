<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#8B5CF6</item>
        <item name="colorPrimaryVariant">#6D28D9</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#38BDF8</item>
        <item name="colorSecondaryVariant">#0EA5E9</item>
        <item name="colorOnSecondary">#07111E</item>
        <item name="android:windowBackground">@color/nc_bg</item>
        <item name="android:statusBarColor">@color/nc_bg</item>
        <item name="android:navigationBarColor">@color/nc_bg</item>
        <item name="materialAlertDialogTheme">@style/RoundedDialogTheme</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="RoundedDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/RoundedShapeAppearance</item>
        <item name="backgroundTint">@color/nc_surface</item>
        <item name="android:windowMinWidthMajor">94%</item>
        <item name="android:windowMinWidthMinor">94%</item>
        <item name="colorSurface">@color/nc_surface</item>
        <item name="materialAlertDialogTitleTextStyle">@style/DialogTitleText</item>
        <item name="materialAlertDialogBodyTextStyle">@style/DialogBodyText</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonTextPrimary</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonTextSecondary</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButtonTextDanger</item>
        <item name="android:backgroundDimAmount">0.65</item>
    </style>

    <style name="RoundedShapeAppearance" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="DialogTitleText" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/nc_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="DialogBodyText" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/nc_text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="DialogButtonTextPrimary" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/nc_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="DialogButtonTextSecondary" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/nc_text_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="DialogButtonTextDanger" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/nc_danger</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
